"""frankie_voice.py — Frankie's voice: British (Alan) + Russian (Dmitri) Piper voices saying the same line at once,
time-matched, British on top (clearer), Russian underneath (quieter, lower, dirtier), then a clipped mechanical chain. Picked by Tony 2026-10-13 10:30 (sample "mix").
render(text, fx, out) is used by frankie.py. Older versions: .frankie_voice.py.bak-alan, .frankie_voice.py.bak-agent
"""
import subprocess, tempfile, wave
from pathlib import Path

VOICES = Path.home() / "tony-tests/voices"
BRITISH, RUSSIAN = VOICES / "en_GB-alan-medium.onnx", VOICES / "ru_RU-dmitri-medium.onnx"
VOICE_PATH = BRITISH  # frankie.py compatibility

# Each mood = (british fx, russian fx, russian mix volume, final fx on the mix).
# British on top: mild grit, stays clear. Russian underneath: quieter, much lower, heavily distorted.
# Final: robotic buzz + tin-can echo + presence EQ, normalize to 0 dB then +gain = deliberate clipping (max loudness).
_FINAL = ["highpass", "120", "tremolo", "100", "20", "echo", "0.8", "0.6", "10", "0.2",
          "equalizer", "3000", "1.2q", "+6", "lowpass", "7500", "gain", "-n", "0"]
NORMAL_FX = (["pitch", "-40", "tempo", "0.9", "overdrive", "6", "10"],
             ["pitch", "-350", "tempo", "0.9", "overdrive", "25", "20", "lowpass", "2500"],
             0.45, _FINAL + ["gain", "2"])
ANGRY_FX = (["pitch", "-80", "tempo", "0.95", "overdrive", "12", "15"],
            ["pitch", "-450", "tempo", "0.95", "overdrive", "35", "20", "lowpass", "2000"],
            0.6, _FINAL + ["gain", "4"])

_loaded = {}


def _voice(path):
    if path not in _loaded:
        from piper import PiperVoice
        _loaded[path] = PiperVoice.load(str(path))
    return _loaded[path]


def _sox(*args):
    subprocess.run(["sox", *args], check=True, timeout=60, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _dur(path):
    with wave.open(path) as w:
        return w.getnframes() / w.getframerate()


def render(text, fx, out):
    """British + Russian say ``text`` together (Russian stretched to the British length), then ``fx``; 22050 Hz mono."""
    with tempfile.TemporaryDirectory(prefix="fv-") as d:
        raws = []
        for i, path in enumerate((BRITISH, RUSSIAN)):
            raw = f"{d}/{i}.wav"
            with wave.open(raw, "wb") as wf:
                _voice(path).synthesize_wav(text, wf)
            raws.append(raw)
        brit_fx, rus_fx, rus_vol, final_fx = fx
        brit, rus = f"{d}/b.wav", f"{d}/r.wav"
        _sox(raws[0], "-r", "22050", "-c", "1", brit, *brit_fx, "gain", "-n", "-3")
        factor = max(0.3, min(3.0, _dur(raws[1]) / _dur(raws[0])))  # Russian stretched to the British length
        _sox(raws[1], "-r", "22050", "-c", "1", rus, "tempo", f"{factor:.3f}", *rus_fx, "gain", "-n", "-3")
        _sox("-m", "-v", "1", brit, "-v", str(rus_vol), rus, "-r", "22050", "-c", "1", str(out), *final_fx)
